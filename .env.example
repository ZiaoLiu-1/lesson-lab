# Supply your own key; never put credentials in browser code or Git.
# Live Studio edits need only this key. Empty keys still allow browsing the sample.
CEREBRAS_API_KEY=
STUDIO_PORT=4320

# Optional direct-API comparison. Both keys are required for this separate tool.
OPENAI_API_KEY=
API_PORT=4337
API_EFFORT=low
# A fresh directory creates a new cohort; existing results are never reset.
# API_DATA_DIR=.local/benchmark-api/my-next-session

# Optional session location and local whisper.cpp overrides:
# STUDIO_DATA_DIR=.local/studio
# LESSON_LAB_WHISPER_BIN=
# LESSON_LAB_WHISPER_MODEL=
