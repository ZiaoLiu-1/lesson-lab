{
  "name": "lesson-lab-demo",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "A local experiment in fast inference and editable study pages.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env studio/server.js",
    "benchmark:api": "node --env-file-if-exists=.env benchmark/api-server.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "voice:setup": "node scripts/setup-local-voice.js --install",
    "voice:check": "node scripts/setup-local-voice.js --check",
    "test": "node --test test/*.test.js"
  },
  "license": "MIT"
}
